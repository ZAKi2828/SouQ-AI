# InsForge Backend & Database Configuration
# Base URL for InsForge backend
NEXT_PUBLIC_INSFORGE_BASE_URL=https://your-project.region.insforge.app

# Anonymous public key for InsForge DB & Storage operations
NEXT_PUBLIC_INSFORGE_ANON_KEY=your_insforge_anon_key_here

# Google Gemini API Key (Required for AI Product Research Agent & Ad Copy Generation)
GEMINI_API_KEY=your_gemini_api_key_here

# Resend API Key for automated transactional emails & notifications
RESEND_API_KEY=re_your_resend_api_key_here

# Optional: Apify Token for external web scraping integration
APIFY_TOKEN=your_apify_token_here
